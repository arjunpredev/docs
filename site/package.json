{
  "name": "predev-docs-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node patches/fumadocs-openapi.mjs && node scripts/prepare.mjs && next dev --port 3100",
    "build": "node patches/fumadocs-openapi.mjs && node scripts/prepare.mjs && next build && node scripts/postbuild.mjs",
    "preview": "wrangler dev --port 8799",
    "check:out": "node scripts/check-out.mjs",
    "check:worker": "wrangler types worker/worker-configuration.d.ts > /dev/null && tsc -p worker/tsconfig.json",
    "test:mcp": "node scripts/test-mcp.mjs",
    "postinstall": "node patches/fumadocs-openapi.mjs && fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-openapi": "12.1.0",
    "fumadocs-ui": "16.15.17",
    "hast-util-to-jsx-runtime": "2.3.6",
    "just-bash": "3.4.2",
    "lucide-react": "1.57.0",
    "next": "16.3.7",
    "posthog-js": "1.435.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1",
    "zbsearch": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.144.0"
  }
}
